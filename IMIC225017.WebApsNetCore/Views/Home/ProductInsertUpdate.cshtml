@{
	var list_category = ViewBag.Categories != null ? (List<IMIC225017.DataAccessNetCore.DataObject.Category>)ViewBag.Categories : new List<IMIC225017.DataAccessNetCore.DataObject.Category>();
}
@model IMIC225017.DataAccessNetCore.DataObject.Product

@Html.Partial("~/Views/Home/app-content-header-partial.cshtml", new IMIC225017.WebApsNetCore.Models.AppContentHeaderModels
{
	Tittle = "Thêm mới sản phẩm"
})
<div class="container">
	<div class="form-group">
		<label for="email">ProductName:</label>
		<input type="hidden" id="ProductID" value="@Model.ProductID" />
		<input type="text" class="form-control" value="@Model.ProductName" id="ProductName" name="ProductName" style="width:50%">
	</div>
	<div class="form-group">
		<label for="pwd">Description:</label>
		<input type="text" class="form-control" value="@Model.Description" id="Description" name="Description" style="width:50%">
	</div>
	<div class="form-group">
		<label for="pwd">Category:</label>
		<select class="form-control" style="width:50%" id="DDlCategoryID">
			<option value="0">Chọn danh mục</option>
			@if (list_category != null && list_category.Count > 0)
			{
				foreach (var item in list_category)
				{
					if (Model.CatorgoryId > 0 && Model.CatorgoryId == item.CategoryID)
					{
						<option value="@item.CategoryID" selected>@item.CategoryName</option>
					}
					else
					{
						<option value="@item.CategoryID">@item.CategoryName</option>
					}
				}
			}
		</select>
	</div>
	<button type="button" id="BtnInsertProduct" class="btn btn-success" style="margin:10px;">Lưu lại</button>
</div>

@section Scripts {

	<script>

		$(document).ready(function(){

			$("#BtnInsertProduct").click(function(){

				ProductInsert();
			});


		});


		function ProductInsert(){

			var productName = $("#ProductName").val();
			var desc = $("#Description").val();

			if(productName=='' || productName== null){
				alert("ProductName không được trống!");
				return;
			}

			var InputData={
				ProductID: $("#ProductID").val(),
				ProductName:productName,
				Description:desc,
				CatorgoryId:$("#DDlCategoryID").val()
			};

			$.ajax({
				url: '/Home/ProductInsert',
				type: 'POST',
				dataType: 'json',
				contentType: 'application/json; charset=utf-8',
				data: JSON.stringify(InputData)
			}).done(function(rs) {
				//	LoadPartialViews();
				console.log(JSON.stringify(rs));
				alert(rs.des);
			});
		}
	</script>

}