@Html.ActionLink("Insert Product", "ProductInsertUpdate", null,null)
<div class="text-center">
	<h1 class="display-4">Welcome</h1>
	<div id="ListProductPartialViews"></div>
</div>

@section Scripts {

	<script>

		$(document).ready(function(){

			LoadPartialViews();

			


		});

		function LoadPartialViews(){

			// thực hiện gọi aJAXX
			var InputData ={
					ColorID :0,
					PageIndex : 1,
					PageSize : 10,
					PriceFrom : 0,
					PriceTo : 0,
					ProductName : "",
					SizeID: 0
			};

			$.ajax({
				url: '/Home/_ListProductPartialViews',
				type: 'POST',
				dataType: 'html',
				contentType: 'application/json; charset=utf-8',
				data: JSON.stringify(InputData)
			}).done(function(rs) {
				$('#ListProductPartialViews').html(rs);
			});

		}
		function Product_Delete(Id){

			var rs =confirm("Bạn có chắc chắn muốn xóa bản ghi này ?");
			if(rs){

				var InputData={
					ProductID: Id,
				};

				$.ajax({
					url: '/Home/Product_Delete',
					type: 'POST',
					dataType: 'json',
					contentType: 'application/json; charset=utf-8',
					data: JSON.stringify(InputData)
				}).done(function(rs) {
					//	LoadPartialViews();
					console.log(JSON.stringify(rs));
					alert(rs.des);
				});
			}
		}
	
	</script>

}