@{
	ViewData["Title"] = "Home Page";
	var des = ViewBag.Desc;
}
@model List<IMIC225017.DataAccessNetCore.DataObject.Product>
<p style="color:red">@des</p>
<form asp-action="Index" method="post">
	<div class="form-group">
		<label for="email">ProductName:</label>
		<input type="text" class="form-control" id="ProductName" name="ProductName" style="width:50%">
	</div>
	<div class="form-group">
		<label for="pwd">Description:</label>
		<input type="text" class="form-control" id="Description" name="Description" style="width:50%">
	</div>

	<button type="submit" class="btn btn-success">Submit</button>
</form>


<div class="text-center">
	<h1 class="display-4">Welcome</h1>
	<table class="table">
		<thead>
			<tr>
				<th>ProductID</th>
				<th>ProductName</th>
				<th>Description</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.Count > 0)
			{
				foreach (var item in Model)
				{
					<tr>
						<td>@item.ProductID</td>
						<td>@item.ProductName</td>
						<td>@item.Description</td>
					</tr>
				}
			}
			else
			{
				<tr>
					<td colspan="3">No products available.</td>
				</tr>
			}

		</tbody>
	</table>
</div>
